    "nami:simulate": "node scripts/nami-simulate.js",
    "nami:drift": "node scripts/nami-drift.js"
  },
  "dependencies": {
    "tree-sitter": "^0.21.1",
    "tree-sitter-typescript": "^0.23.2",
    "js-yaml": "^4.1.0",
    "simple-git": "^3.27.0",
    "dotenv": "^16.4.5"
  }
}
