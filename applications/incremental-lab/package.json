{
  "name": "incremental-lab",
  "version": "0.1.0",
  "description": "Sandbox for incremental symbol-graph rebuild engine (analyze + synthesis).",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test 'test/unit/*.test.js' 'test/*.test.js'",
    "test:unit": "node --test 'test/unit/*.test.js'",
